# EmailJS uses only its PUBLIC key in the browser. Never add a private key here.
VITE_EMAILJS_SERVICE_ID=default_service
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional: own Google Maps Embed API key for the Street View panorama
VITE_GOOGLE_MAPS_EMBED_API_KEY=

# Completed continuous 360-degree camera orbit: Arina in the ARKA room.
# Optional override. Blank uses the included /videos/arina-orbit-wide.mp4.
VITE_ARINA_ORBIT_VIDEO_URL=

# Server environment only (hosting or private file outside project).
# These are documentation placeholders, not frontend .env.local settings.
# Never use a VITE_ prefix for the key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash
